ENVIRONMENT=local
LOG_LEVEL=INFO

API_HOST=0.0.0.0
API_PORT=8000
CORS_ALLOW_ORIGINS=*

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=agentic_graphrag
POSTGRES_USER=graphrag
POSTGRES_PASSWORD=graphrag

REDIS_URL=redis://redis:6379/0

NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=agentic-graphrag-password

QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=INSERT API KEY HERE
QDRANT_COLLECTION=documents
VECTOR_SIZE=384

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=agentic-graphrag

OLLAMA_BASE_URL=http://ollama:11434
DEFAULT_LLM_PROVIDER=ollama
DEFAULT_LLM_MODEL=llama3.1:8b
DEFAULT_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

OPENAI_API_KEY=INSERT API KEY HERE
ANTHROPIC_API_KEY=INSERT API KEY HERE

CHAT_GRAPH_BACKEND=local
CHAT_VECTOR_BACKEND=local
# CHAT_API_KEY=your-private-chat-api-key
